  # P.E.T.E.R. environment configuration
# Copy this file to .env and fill in your keys (see README.md).

# LiveKit (required)
LIVEKIT_URL=wss://project-p-e-t-e-r-b7e84u03.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Google AI / Gemini Realtime (required for speech)
# Get a free API key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key

# Agent name (must match your LiveKit agent deployment)
AGENT_ID=peter-assistant

# Spotify (optional — for the "play my music" feature)
# Create a free app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Local desktop flow:
#   SPOTIFY_REDIRECT_URI=http://127.0.0.1:9090/callback
# Cloud flow (see DEPLOY_CLOUD.md):
#   SPOTIFY_REDIRECT_URI=https://<your-app>.onrender.com/spotify/callback
SPOTIFY_REDIRECT_URI=http://127.0.0.1:9090/callback

# Optional: cloud memory (recommended for cloud deploys so Peter remembers
# you across redeploys). Get a key at https://app.mem0.ai
MEM0_API_KEY=

# Cloud hosting (only used when deployed — e.g. Render):
#   PUBLIC_URL=https://<your-app>.onrender.com
#   PORT is set automatically by the host (Render/Railway/Fly).
PUBLIC_URL=

# Optional: point this DESKTOP install's Agenda panel + voice calendar tools
# at a deployed mobile_backend.py (e.g. your Render URL) so the calendar you
# see on desktop is the SAME one your phone sees, instead of a separate local
# file. Leave blank for local-only (no cloud deploy). NEVER set this on the
# Render deployment's own environment — it must stay local there since it IS
# the shared store, not a proxy to itself.
#   CALENDAR_API_URL=https://<your-app>.onrender.com
CALENDAR_API_URL=
